  print("Invalid Choice.")



VERSION 2 PYTHON CODE (ENHANCED & IMPROVED):
# Modular Calculator - Version 2 (With Proper Comments)

# Function for addition
def add_numbers(num1, num2):
    return num1 + num2

# Function for subtraction
def subtract_numbers(num1, num2):
    return num1 - num2

# Function for multiplication
def multiply_numbers(num1, num2):
    return num1 * num2

# Function for division
def divide_numbers(num1, num2):
    return num1 / num2

# Ask the user to input two numbers
print("=== MODULAR CALCULATOR ===")
first_number = float(input("Enter first number: "))
second_number = float(input("Enter second number: "))

# Display the available operations
print("\nChoose an operation:")
print("1 - Addition")
print("2 - Subtraction")
print("3 - Multiplication")
print("4 - Division")

# Get the user's choice
choice = input("Enter choice (1-4): ")

# Call the selected function and display the result
if choice == "1":
    result = add_numbers(first_number, second_number)
    print("Result:", result)
elif choice == "2":
    result = subtract_numbers(first_number, second_number)
    print("Result:", result)
elif choice == "3":
    result = multiply_numbers(first_number, second_number)
    print("Result:", result)
elif choice == "4":
    # Check if division by zero will occur
    if second_number == 0:
        print("Cannot divide by zero.")
    else:
        result = divide_numbers(first_number, second_number)
        print("Result:", result)
else:
  print("Invalid Choice.")



