# Task 1:

def get_sum(limit):
    total = 0

    for number in range(0, limit + 1):
        total += number

    return total


print(get_sum(0))
print(get_sum(4))

# Task 2:

def check_password(correct_password):
    while True:
        attempt = input("Enter the demo password: ")

        if attempt == "":
            print("Password cannot be blank.")
            continue

        if attempt == correct_password:
            print("Access granted!")
            break

        print("Incorrect password. Try again.")

    return True


check_password("python8")

# Task 3:

def display_pattern(rows, columns):
    for row in range(rows):
        for column in range(columns):
            print("*", end="")
        print()

display_pattern(7, 4)

# Task 4:

def skip_multiples(limit):
    for number in range(1, limit + 1):
        if number % 3 == 0:
            continue
        print(number)


skip_multiples(15)

# Extension:

def skip_multiples_of_three_and_five(limit):
    for number in range(1, limit + 1):
        if number % 3 == 0 or number % 5 == 0:
            continue
        print(number)


skip_multiples_of_three_and_five(20)



